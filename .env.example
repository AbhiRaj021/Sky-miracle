# Copy to .env.local and fill in the values from your Supabase project
# (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (newer projects) or anon key (older projects); either works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of this app, used in auth email links (verification, password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Not used by the app today; only needed for admin scripts.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
